# --- Application Info ---
APP_NAME="CollectionAI_Batch"
VERSION="1.0.0"
DEBUG=False

# --- Oracle Database Config ---
DB_USER="your_db_username"
DB_PASSWORD="your_db_password"
DB_DSN="localhost/orclpdb1"
DB_MIN_POOL=2
DB_MAX_POOL=5
INST_CODE="1"
COUNTRY_CODE="400"
BATCH_SIZE=1000

# --- Execution Mode ---
MODE="FULL"
MODEL_SCOPE="BOTH"
SHAP_SCOPE="BOTH"

# --- Model Thresholds ---
WILLINGNESS_THRESHOLD=0.7
ABILITY_THRESHOLD=0.5

# --- Snapshot Date Override (TESTING ONLY) ---
# Leave blank/unset in production — get_snap_date() will call the real
# Oracle SNAP_DATE() function. Only set this to pin the pipeline's
# business date while testing against a DB without SNAP_DATE() wired up.
SNAP_DATE_OVERRIDE=

# --- Artifact Retention ---
# Number of most-recent model/cache files to keep per model type; older
# ones are pruned automatically after each pipeline run.
RETENTION_KEEP_N=10

# --- LLM Narrative Config (LM Studio — Local Fallback) ---
LLM_BASE_URL="http://localhost:1234/v1"
LLM_MODEL_NAME="your-local-model-name-here"
LLM_API_KEY="lm-studio"

# --- OpenAI API Config (Executive Demo / Cloud toggle) ---
# Set USE_OPENAI_API=True to route all LLM calls to OpenAI instead of LM Studio
USE_OPENAI_API=False
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_NAME="gpt-4o"
